# --- Groq: per-model quota buckets. The refill is a ROLLING window, not a
# fixed daily reset -- verified against x-ratelimit headers. Schedule heavy
# runs by measured headroom (scripts/diag/run_guard.py preflight), not by clock.
GROQ_API_KEY=

# Bulk lane: corpus generation, Day-2 eval sweeps. Highest RPD/TPD.
GROQ_MODEL_BULK=llama-3.1-8b-instant

# Quality lane: final held-out measurement, live demo. 100K TPD ceiling.
GROQ_MODEL_QUALITY=llama-3.3-70b-versatile

# --- Gemini: failover only. Separate vendor, reset midnight PT (12:30 IST) --
# Verify any model string with a one-line generate_content("hi") before use.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Optional: hosted persistence for live mode ----------------------------
# Without these the deployment still runs; cases are processed in memory and
# not stored, which also disables duplicate suppression.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
